local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("ULTRA CHEAT GUI! BY GREEN DEPTH", "Ocean")

-- Services & Players
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local uis = game:GetService("UserInputService")
local runService = game:GetService("RunService")

-- Script States
local targetSpeed = 16 
local targetJump = 50
local targetSize = 1
local flying = false
local flySpeed = 50
local Keys = {a = false, d = false, w = false, s = false}

-- Dynamic Scaling and Automatic Floor/Hip Calibration
local function scaleCharacter(character, scale)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    -- Update standard R15 scale values natively
    local scales = {"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}
    for _, name in ipairs(scales) do
        local val = humanoid:FindFirstChild(name)
        if val and val:IsA("NumberValue") then
            val.Value = scale
        end
    end
    
    -- Adjust HipHeight automatically based on scale factor so you never clip or get stuck
    humanoid.HipHeight = 1.35 * scale
end

-- Streamlined Property Monitor (No heavy math, pure values)
runService.Heartbeat:Connect(function()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        -- Direct assignment bypasses internal mass barriers
        humanoid.WalkSpeed = targetSpeed
        humanoid.JumpPower = targetJump
        humanoid.UseJumpPower = true
    end
end)

-- Absolute Positional Flight Engine (Ignores all game physics, masses, and blocks)
runService.RenderStepped:Connect(function()
    if not flying then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    
    local camera = workspace.CurrentCamera
    local moveDirection = Vector3.new(0, 0, 0)
    
    -- Detect directions
    if Keys.w then moveDirection = moveDirection + camera.CFrame.LookVector end
    if Keys.s then moveDirection = moveDirection - camera.CFrame.LookVector end
    if Keys.a then moveDirection = moveDirection - camera.CFrame.RightVector end
    if Keys.d then moveDirection = moveDirection + camera.CFrame.RightVector end
    
    -- Zero out actual movement drops so your character stays level
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    -- Teleport the CFrame cleanly frame-by-frame based on the speed slider
    if moveDirection.Magnitude > 0 then
        root.CFrame = CFrame.new(root.Position + (moveDirection.Unit * (flySpeed / 10)), root.Position + camera.CFrame.LookVector)
    else
        root.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector)
    end
end)

-- Keybind Input Tracking
uis.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.W then Keys.w = true
    elseif input.KeyCode == Enum.KeyCode.S then Keys.s = true
    elseif input.KeyCode == Enum.KeyCode.A then Keys.a = true
    elseif input.KeyCode == Enum.KeyCode.D then Keys.d = true end
end)

uis.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then Keys.w = false
    elseif input.KeyCode == Enum.KeyCode.S then Keys.s = false
    elseif input.KeyCode == Enum.KeyCode.A then Keys.a = false
    elseif input.KeyCode == Enum.KeyCode.D then Keys.d = false end
end)

-- UI Structure
local MainTab = Window:NewTab("Main")
local MainSection = MainTab:NewSection("Player Exploits")

-- WalkSpeed Slider
MainSection:NewSlider("WalkSpeed", "Adjust character movement speed", 250, 16, function(s)
    targetSpeed = tonumber(s) or 16
end)

-- JumpPower Slider
MainSection:NewSlider("JumpPower", "Adjust character jump height", 500, 50, function(j)
    targetJump = tonumber(j) or 50
end)

-- Character Height Scaler
MainSection:NewSlider("Character Scale", "Change R15 body dimensions (1 = Normal)", 15, 1, function(scale)
    targetSize = tonumber(scale) or 1
    scaleCharacter(LocalPlayer.Character, targetSize)
end)

-- Fly Speed Slider
MainSection:NewSlider("Fly Speed", "Adjust flight acceleration speed", 300, 10, function(f)
    flySpeed = tonumber(f) or 50
end)

-- Re-apply size alterations when spawning in
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    scaleCharacter(char, targetSize)
end)

-- Flight Toggle
MainSection:NewButton("Toggle Fly", "Enables or disables absolute flight mode", function()
    flying = not flying
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if flying then
                humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            else
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end
end)
